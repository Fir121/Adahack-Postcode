    "info": {
        "title": "Postcode Green Map API",
        "version": "1.0"
    },
    "produces": [
        "application/json"
    ],
    "consumes": [
        "application/json"
    ],
    "tags": [
        {
            "name": "coordinates",
            "description": "Postcode coordinates"
        },
        {
            "name": "tasks",
            "description": "Operations related to tasks"
        },
        {
            "name": "users",
            "description": "Operations related to users"
        }
    ],
    "definitions": {
        "Coordinates": {
            "required": [
                "latitude",
                "longitude",
                "postcode"
            ],
            "properties": {
                "postcode": {
                    "type": "string",
                    "example": "EH1 1YZ"
                },
                "latitude": {
                    "type": "number",
                    "example": 55.9533
                },
                "longitude": {
                    "type": "number",
                    "example": -3.1883
                }
            },
            "type": "object"
        },
        "Error": {
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Postcode not found"
                }
            },
            "type": "object"
        },
        "Task": {
            "required": [
                "description",
                "name",
                "points",
                "task_id"
            ],
            "properties": {
                "task_id": {
                    "type": "string",
                    "description": "Task ID"
                },
                "name": {
                    "type": "string",
                    "description": "Task name"
                },
                "description": {
                    "type": "string",
                    "description": "Task description"
                },
                "points": {
                    "type": "integer",
                    "description": "Task points"
                }
            },
            "type": "object"
        },
        "UserInput": {
            "required": [
                "email",
                "name",
                "postcode"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "User name"
                },
                "email": {
                    "type": "string",
                    "description": "User email"
                },
                "postcode": {
                    "type": "string",
                    "description": "User postcode"
                }
            },
            "type": "object"
        },
        "User": {
            "required": [
                "email",
                "name",
                "postcode",
                "user_id"
            ],
            "properties": {
                "user_id": {
                    "type": "string",
                    "description": "User ID"
                },
                "name": {
                    "type": "string",
                    "description": "User name"
                },
                "email": {
                    "type": "string",
                    "description": "User email"
                },
                "postcode": {
                    "type": "string",
                    "description": "User postcode"
                }
            },
            "type": "object"
        }
    },
    "responses": {
        "ParseError": {
            "description": "When a mask can't be parsed"
        },
        "MaskError": {
            "description": "When any error occurs on mask"
        }
    }
}