{
    "swagger": "2.0",
    "basePath": "/api/v1",
    "paths": {
        "/coordinates/": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Coordinates"
                            }
                        }
                    }
                },
                "summary": "Get latitude and longitude for all postcodes",
                "operationId": "list_coordinates",
                "parameters": [
                    {
                        "name": "X-Fields",
                        "in": "header",
                        "type": "string",
                        "format": "mask",
                        "description": "An optional fields mask"
                    }
                ],
                "tags": [
                    "coordinates"
                ]
            }
        },
        "/coordinates/{postcode}": {
            "parameters": [
                {
                    "in": "path",
                    "description": "Postcode",
                    "name": "postcode",
                    "required": true,
                    "type": "string"
                }
            ],
            "get": {
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/Coordinates"
                        }
                    },
                    "404": {
                        "description": "Postcode not found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "400": {
                        "description": "Invalid postcode",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                },
                "summary": "Get latitude and longitude for a single postcode",
                "operationId": "get_coordinates",
                "parameters": [
                    {
                        "name": "X-Fields",
                        "in": "header",
                        "type": "string",
                        "format": "mask",
                        "description": "An optional fields mask"
                    }
                ],
                "tags": [
                    "coordinates"
                ]
            }
        },
        "/tasks": {
            "get": {
                "responses": {
                    "200": {
