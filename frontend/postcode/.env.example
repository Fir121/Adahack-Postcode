# Live Swagger API is the default. Set true for the browser-local hackathon demo.
NEXT_PUBLIC_USE_MOCK_API=false
# Server-side URL includes the Swagger base path; browser CORS is not required.
API_BASE_URL=https://chivalry-handlebar-hangover.ngrok-free.dev/api/v1
# Optional direct browser override; otherwise /api/backend is used.
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Optional static external form URL. Otherwise task feedback opens /feedback?task_id=...
# NEXT_PUBLIC_TASK_FEEDBACK_URL=https://your-feedback-form.example
# Enable a shared one-hour bonus window. Start must include Z or a timezone offset.
# Public env settings require a rebuild/restart after changes.
NEXT_PUBLIC_GREEN_HOUR_ENABLED=false
NEXT_PUBLIC_GREEN_HOUR_START_AT=
# Example: NEXT_PUBLIC_GREEN_HOUR_START_AT=2026-10-03T14:00:00+01:00
# Server-side proxy logging (info/warn/error/off). No request bodies or query values.
API_LOG_LEVEL=info
API_LOG_FILE=logs/api-proxy.log
